+      <div v-if="!studioSessionConnected || state?.error" role="status" class="tf:flex tf:items-center tf:gap-2 tf:px-3 tf:py-2 tf:text-xs">
+        <span class="tf:min-w-0 tf:flex-1">{{ state?.error || studioSessionStatus }}</span>
+        <el-button text size="small" @click="reconnect">重新连接</el-button>
+      </div>
+      <el-button v-if="state?.hasMore" text size="small" :loading="state.loadingOlder" @click="loadOlder">加载更早消息</el-button>
+      <messageList ref="messages" :messages="state?.messages ?? []" :directory="directory" :active="visible" :disabled="!studioSessionConnected"
+        :locked="locked" :busy="!!state?.running" :remoteRunning="!!state?.running" :compacting="false" :voiceActive="voiceActive" shared
+        @fillPrompt="input?.fillPrompt($event)" @copy="copyMessage" />
+      <messageInput ref="input" v-model:selectedModel="selectedModel" v-model:reasoningEffort="reasoningEffort"
+        v-model:voiceActive="voiceActive" v-model:restoringAttachment="restoringAttachment"
+        :active="visible" :disabled="!studioSessionConnected || sending || stopping" :busy="!!state?.running" :remoteRunning="!!state?.running"
+        :directory="directory" :contextWindow="0" :sharedModelLabel="state?.modelLabel || 'dsh 当前模型'" @submit="sendMessage" @stop="stopMessage">
+        <template #modelSelector><studioModelPicker :disabled="locked" /></template>
+      </messageInput>
+    </div>
+  </section>
+</template>
+
+<script setup lang="ts">
+import { computed, ref } from "vue";
+import { IconX } from "@tabler/icons-vue";
+import { ElMessage } from "element-plus";
+import { studioChatState as state, studioSessionConnected, studioSessionStatus, requestStudioSession, sendStudioPrompt } from "@/lib/studioSession";
+import { useWorkspaceStore } from "@/stores/workspace";
+import { writeClipboardText } from "@/lib/clipboard";
+import messageList from "./conversation/messageList.vue";
+import messageInput from "./conversation/messageInput.vue";
+import studioModelPicker from "./studioModelPicker.vue";
+
+const visible = defineModel<boolean>({ default: false });
+const directory = computed(() => useWorkspaceStore().project?.directory);
+const input = ref<InstanceType<typeof messageInput>>();
+const messages = ref<InstanceType<typeof messageList>>();
+const selectedModel = ref("");
+const reasoningEffort = ref("");
+const voiceActive = ref(false);
+const restoringAttachment = ref(false);
+const sending = ref(false);
+const stopping = ref(false);
+const locked = computed(() => !studioSessionConnected.value || sending.value || !!state.value?.running || voiceActive.value || restoringAttachment.value);
+const activityLabel = computed(() => !studioSessionConnected.value ? "连接中" : state.value?.activity === "running" ? "运行中"
+  : state.value?.activity === "stopped" ? "已停止" : state.value?.activity === "error" ? "运行失败" : state.value?.activity === "completed" ? "已完成" : "已同步");
+
+async function sendMessage() {
+  if (locked.value || !directory.value) return;
+  const draft = input.value?.getDraft();
+  if (!draft || (!draft.prompt.trim() && !draft.attachments.length)) return;
+  const mentions = draft.mentions.filter(mention => draft.mentionedIds.includes(mention.id));
+  if (draft.mentionedIds.some(id => !mentions.some(mention => mention.id === id))) return ElMessage.warning("存在无法读取的提及，请删除后重新选择");
+  sending.value = true;
+  try {
+    await sendStudioPrompt(directory.value, draft.prompt.trim(), draft.attachments, mentions);
+    await input.value?.clearDraft();
+    await messages.value?.scrollToLatest();
+  } catch (error) { ElMessage.error(error instanceof Error ? error.message : "发送失败，输入内容已保留"); }
+  finally { sending.value = false; }
+}
+
+async function stopMessage() {
+  if (stopping.value || !state.value?.running) return;
+  stopping.value = true;
+  try { await requestStudioSession("stop"); }
+  catch (error) { ElMessage.error(error instanceof Error ? error.message : "停止失败，请重试"); }
+  finally { stopping.value = false; }
+}
+
+async function reconnect() {
+  try { await requestStudioSession("bind"); }
+  catch (error) { ElMessage.error(error instanceof Error ? error.message : "连接失败，请重试"); }
+}
+
+async function openHostChat() {
+  try { await requestStudioSession("openChat"); }
+  catch (error) { ElMessage.error(error instanceof Error ? error.message : "打开会话失败"); }
+}
+
+async function loadOlder() {
+  try { await requestStudioSession("older"); }
+  catch (error) { ElMessage.error(error instanceof Error ? error.message : "加载历史失败"); }
+}
+
+async function copyMessage(content: string) {
+  try { await writeClipboardText(content); ElMessage.success("已复制"); }
+  catch { ElMessage.error("复制失败，请重试"); }
+}
