+<template>
+  <details class="tf:relative tf:min-w-0 tf:flex-1 tf:text-xs">
+    <summary class="tf:cursor-pointer tf:list-none tf:truncate tf:py-1" :title="state?.modelLabel">
+      {{ state?.modelMode === 'custom' ? '自选' : '跟随系统' }} · {{ state?.modelLabel || '正在读取模型' }} ▾
+    </summary>
+    <div class="tf:absolute tf:bottom-full tf:left-0 tf:z-50 tf:mb-2 tf:flex tf:w-72 tf:max-w-[75vw] tf:flex-col tf:gap-3 tf:rounded-lg tf:border tf:border-(--el-border-color) tf:bg-(--el-bg-color-overlay) tf:p-3 tf:shadow-lg">
+      <label class="tf:flex tf:flex-col tf:gap-1">文本模型
+        <select aria-label="文本模型来源" :value="state?.modelMode || 'system'" :disabled="disabled || saving" class="tf:rounded tf:border tf:border-(--el-border-color) tf:bg-(--el-bg-color) tf:p-2 tf:text-inherit" @change="changeMode">
+          <option value="system">跟随系统默认模型</option><option value="custom">为当前项目自选模型</option>
+        </select>
+      </label>
+      <label v-if="state?.modelMode === 'custom'" class="tf:flex tf:flex-col tf:gap-1">已配置的 dsh 模型
+        <select aria-label="项目文本模型" :value="selectedKey" :disabled="disabled || saving" class="tf:w-full tf:rounded tf:border tf:border-(--el-border-color) tf:bg-(--el-bg-color) tf:p-2 tf:text-inherit" @change="changeModel">
+          <option v-if="!models.some(item => item.key === selectedKey)" :value="selectedKey" disabled>{{ state.modelLabel || '请选择模型' }}</option>
+          <optgroup v-for="group in state.modelGroups" :key="group.id" :label="group.name"><option v-for="model in group.models" :key="model.id" :value="modelKey(group.id, model.id)">{{ model.name }}</option></optgroup>
+        </select>
+      </label>
+      <label v-if="state?.modelMode === 'custom' && efforts.length" class="tf:flex tf:flex-col tf:gap-1">思考强度
+        <select aria-label="模型思考强度" :value="state.modelSelection?.reasoningEffort || currentModel?.reasoning?.defaultEffort" :disabled="disabled || saving" class="tf:rounded tf:border tf:border-(--el-border-color) tf:bg-(--el-bg-color) tf:p-2 tf:text-inherit" @change="changeEffort"><option v-for="effort in efforts" :key="effort.id" :value="effort.id">{{ effort.name }}</option></select>
+      </label>
+      <p class="tf:m-0 tf:text-(--el-text-color-secondary)">{{ state?.modelMode === 'custom' ? '只修改当前项目，下次发送生效。' : '连接和发送前同步 dsh 默认模型。' }}</p>
+      <p v-if="error || state?.modelError" role="alert" class="tf:m-0 tf:text-(--el-color-danger)">{{ error || state?.modelError }}</p>
+      <button type="button" :disabled="saving" class="tf:cursor-pointer tf:rounded tf:border-0 tf:bg-(--el-fill-color) tf:p-2 tf:text-inherit" @click="openSettings">添加 / 管理自定义模型…</button>
+    </div>
+  </details>
+</template>
+
+<script setup lang="ts">
+import { computed, ref } from "vue";
+import { ElMessage } from "element-plus";
+import { studioChatState as state, requestStudioSession, type StudioModelChoice } from "@/lib/studioSession";
+
+interface Props { disabled: boolean }
+defineProps<Props>();
+const saving = ref(false);
+const error = ref("");
+const modelKey = (provider: string, model: string) => JSON.stringify([provider, model]);
+const models = computed(() => state.value?.modelGroups.flatMap(group => group.models.map(model => ({ ...model, provider: group.id, key: modelKey(group.id, model.id) }))) ?? []);
+const selectedKey = computed(() => state.value?.modelSelection ? modelKey(state.value.modelSelection.provider, state.value.modelSelection.model) : "");
+const currentModel = computed(() => models.value.find(model => model.key === selectedKey.value));
+const efforts = computed(() => currentModel.value?.reasoning?.efforts ?? []);
+
+async function select(choice: StudioModelChoice) {
+  if (saving.value) return;
+  saving.value = true;
+  error.value = "";
+  try { await requestStudioSession("model", undefined, undefined, choice); }
+  catch (cause) { error.value = cause instanceof Error ? cause.message : "模型切换失败，请重试"; }
+  finally { saving.value = false; }
+}
+
+function changeMode(event: Event) {
+  const mode = (event.target as HTMLSelectElement).value;
+  if (mode === "system") void select({ mode });
+  else if (state.value?.modelSelection) void select({ mode: "custom", selection: state.value.modelSelection });
+}
+
+function changeModel(event: Event) {
+  const model = models.value.find(item => item.key === (event.target as HTMLSelectElement).value);
+  if (model) void select({ mode: "custom", selection: { provider: model.provider, model: model.id, reasoningEffort: model.reasoning?.defaultEffort } });
+}
+
+function changeEffort(event: Event) {
+  if (state.value?.modelSelection) void select({ mode: "custom", selection: { ...state.value.modelSelection, reasoningEffort: (event.target as HTMLSelectElement).value } });
+}
+
+async function openSettings() {
+  try { await requestStudioSession("modelSettings"); ElMessage.info("在 dsh 设置的模型页面添加供应商或模型，保存后返回此处选择。"); }
+  catch (cause) { error.value = cause instanceof Error ? cause.message : "无法打开模型设置"; }
+}
+</script>
