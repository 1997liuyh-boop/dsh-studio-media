+++ b/apps/web/src/lib/studioDiscussion.ts
@@ -0,0 +1,36 @@
+import { translate } from "@toonflow/i18n";
+import type { AgentMessage } from "@/components/agent/types";
+import { mentionPlainText } from "@/components/agent/mentionText";
+import { readTextAttachment } from "@/components/agent/textAttachments";
+
+/** 携带文本附件和已保存媒体路径；原消息与原附件保持不变。 */
+export async function shareStudioMessage(message: Pick<AgentMessage, "content" | "attachments" | "mentions">, directory?: string, canvasId?: string): Promise<void> {
+  const parts = ["来自 AI短剧工作台（Toonflow）的协作资料", "工作目录：" + (directory || "尚未打开项目"), "当前画布：" + (canvasId || "尚未选择"), mentionPlainText(message.content, message.mentions)];
+  for (const attachment of message.attachments ?? []) {
+    if (attachment.mimeType === "text/plain") parts.push("文本附件：" + attachment.name + "\n" + await readTextAttachment(attachment, directory));
+    else if (attachment.path) parts.push("附件：" + attachment.name + "\n相对工作目录的路径：" + attachment.path);
+    else throw new Error(translate("请先保存图片、视频或文档附件，再交给 App 协作"));
+  }
+  await requestStudioDiscussion(parts.join("\n\n"));
+}
+
+
+/** 将用户主动选择的资料交给工作室宿主，仅写入草稿，等待用户发送。 */
+export function requestStudioDiscussion(text: string): Promise<void> {
+  const origin = window.location.ancestorOrigins?.[0] || (document.referrer ? new URL(document.referrer).origin : "");
+  if (!origin || origin === "null" || window.parent === window) return Promise.reject(new Error(translate("请在 App 工作室中使用协作")));
+  if (text.length > 100000) return Promise.reject(new Error(translate("协作内容不能超过 100000 字符，请精简后重试")));
+  const requestId = crypto.randomUUID();
+  return new Promise((resolve, reject) => {
+    const cleanup = () => { clearTimeout(timer); window.removeEventListener("message", receive); };
+    const receive = (event: MessageEvent) => {
+      if (event.source !== window.parent || event.origin !== origin || event.data?.type !== "dsh:studio:discussionResult" || event.data.requestId !== requestId) return;
+      cleanup();
+      if (event.data.accepted === true) resolve();
+      else reject(new Error(typeof event.data.message === "string" ? event.data.message : translate("App 协作暂不可用")));
+    };
+    const timer = setTimeout(() => { cleanup(); reject(new Error(translate("App 协作未响应，请确认已打开 App 对话后重试"))); }, 7000);
+    window.addEventListener("message", receive);
+    window.parent.postMessage({ type: "dsh:studio:discuss", requestId, text }, origin);
+  });
+}
