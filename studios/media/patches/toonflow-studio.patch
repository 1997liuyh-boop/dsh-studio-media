@@ -0,0 +1,187 @@
+import { onScopeDispose, ref, watch } from "vue";
+import "./studioSession.css";
+import { useRouter } from "vue-router";
+import { isStudioEmbedded } from "./platform";
+import type { AgentAttachment, AgentMessage } from "@/components/agent/types";
+import type { AgentMention } from "@toonflow/server/agent/types";
+import { mentionPlainText } from "@/components/agent/mentionText";
+import { readTextAttachment } from "@/components/agent/textAttachments";
+import useWorkspaceFiles from "@/lib/workspaceFiles";
+import { useWorkspaceStore } from "@/stores/workspace";
+
+interface StudioContext { directory: string | null; canvasId: string | null }
+export interface StudioModelChoice { mode: "system" | "custom"; selection?: { provider: string; model: string; reasoningEffort?: string } }
+export const studioSessionStatus = ref("正在连接 dsh 会话");
+interface StudioChatState {
+  revision: number;
+  running: boolean;
+  activity: "running" | "stopped" | "completed" | "error" | "idle";
+  hasMore: boolean;
+  loadingOlder: boolean;
+  modelLabel: string;
+  modelMode: "system" | "custom";
+  modelSelection: StudioModelChoice["selection"] | null;
+  modelGroups: { id: string; name: string; models: { id: string; name: string; reasoning?: { defaultEffort?: string; efforts: { id: string; name: string }[] } }[] }[];
+  modelStatus: string;
+  modelError: string | null;
+  messages: AgentMessage[];
+  error?: string;
+}
+export const studioChatState = ref<StudioChatState | null>(null);
+export const studioSessionConnected = ref(false);
+let currentContext: StudioContext = { directory: null, canvasId: null };
+let currentChannel = crypto.randomUUID();
+let boundSessionId = "";
+let pendingSend: Promise<void> | undefined;
+const studioOrigin = window.location.ancestorOrigins?.[0] || (document.referrer ? new URL(document.referrer).origin : "");
+
+/** 仅向直属工作室发送用户动作，不在网页中复制模型凭据或启动第二个 Agent。 */
+export function requestStudioSession(action: "bind" | "send" | "openChat" | "release" | "stop" | "older" | "model" | "modelSettings", context = currentContext, text?: string, modelChoice?: StudioModelChoice): Promise<{ sessionId?: string }> {
+  const origin = studioOrigin;
+  if (!isStudioEmbedded || !origin || origin === "null") return Promise.reject(new Error("请在 App 工作室中使用 dsh 会话"));
+  const requestId = crypto.randomUUID();
+  const channel = currentChannel;
+  // 跨窗口只发送普通字段，避免 Vue 响应式代理无法克隆。
+  const choice = modelChoice ? { mode: modelChoice.mode, ...(modelChoice.selection ? { selection: {
+    provider: modelChoice.selection.provider, model: modelChoice.selection.model,
+    ...(modelChoice.selection.reasoningEffort === undefined ? {} : { reasoningEffort: modelChoice.selection.reasoningEffort }),
+  } } : {}) } : undefined;
+  return new Promise((resolve, reject) => {
+    const cleanup = () => { clearTimeout(timer); window.removeEventListener("message", receive); };
+    const receive = (event: MessageEvent) => {
+      if (event.source !== window.parent || event.origin !== origin || event.data?.type !== "dsh:studio:sessionResult" || event.data.requestId !== requestId) return;
+      cleanup();
+      if (event.data.accepted === true) {
+        if (action === "bind" && channel === currentChannel && context.directory === currentContext.directory) {
+          boundSessionId = event.data.sessionId ?? "";
+          studioSessionConnected.value = true;
+          studioSessionStatus.value = "已连接 dsh 共享会话";
+        }
+        resolve({ sessionId: event.data.sessionId });
+      } else reject(new Error(event.data.message || "dsh 会话暂不可用"));
+    };
+    const timer = setTimeout(() => { cleanup(); reject(new Error("dsh 会话连接超时，请点击 dsh 对话重试")); }, 45000);
+    window.addEventListener("message", receive);
+    window.parent.postMessage({ type: "dsh:studio:session", requestId, channelId: channel, action, ...context, text, modelChoice: choice }, origin);
+  });
+}
+
+export function useStudioSession(read: () => StudioContext) {
+  if (!isStudioEmbedded) return;
+  const router = useRouter();
+  let revision = 0;
+  const context = () => router.currentRoute.value.path === "/workspace" ? read() : { directory: null, canvasId: null };
+  const connect = async (value: StudioContext) => {
+    const version = ++revision;
+    currentContext = value;
+    studioSessionConnected.value = false;
+    boundSessionId = "";
+    try {
+      if (!currentContext.directory) { studioChatState.value = null; await requestStudioSession("release"); return; }
+      currentChannel = crypto.randomUUID();
+      studioChatState.value = null;
+      studioSessionStatus.value = "正在连接 dsh 会话";
+      const result = await requestStudioSession("bind");
+      if (version === revision) {
+        boundSessionId = result.sessionId ?? "";
+        studioSessionConnected.value = true;
+        studioSessionStatus.value = "已连接 dsh 共享会话";
+      }
+      if (version === revision) await sendPendingStudioPrompt();
+    } catch (error) { if (version === revision) studioSessionStatus.value = error instanceof Error ? error.message : "连接失败，请重试"; }
+  };
+  watch(() => JSON.stringify(context()), json => connect(JSON.parse(json)), { immediate: true, flush: "post" });
+  const resume = (event: MessageEvent) => {
+    if (event.source !== window.parent || event.origin !== studioOrigin) return;
+    const data = event.data;
+    if (data?.type === "dsh:studio:resume") { void connect(context()); return; }
+    if (data?.type !== "dsh:studio:state" || data.channelId !== currentChannel || data.directory !== currentContext.directory
+      || typeof data.sessionId !== "string" || (boundSessionId && data.sessionId !== boundSessionId) || !validChatState(data.state)
+      || data.state.revision <= (studioChatState.value?.revision ?? -1)) return;
+    // 保留用户展开的思考和工具卡片，流式更新只替换消息数据。
+    const previous = new Map(studioChatState.value?.messages.flatMap(message => message.parts ?? []).map(part => [part.id, part]));
+    for (const message of data.state.messages) for (const part of message.parts ?? []) {
+      const old = previous.get(part.id);
+      if (part.type !== "text" && old && old.type !== "text" && old.type === part.type) part.collapsed = old.collapsed;
+    }
+    studioChatState.value = data.state;
+  };
+  window.addEventListener("message", resume);
+  onScopeDispose(() => { revision++; studioSessionConnected.value = false; studioChatState.value = null; window.removeEventListener("message", resume); void requestStudioSession("release").catch(() => {}); });
+}
+
+/** 对跨窗口消息仅接受聊天展示所需字段，拒绝损坏的推送。 */
+function validChatState(value: unknown): value is StudioChatState {
+  if (!value || typeof value !== "object") return false;
+  const state = value as Record<string, unknown>;
+  if (!Number.isSafeInteger(state.revision) || typeof state.running !== "boolean" || typeof state.hasMore !== "boolean"
+    || !["running", "stopped", "completed", "error", "idle"].includes(String(state.activity))
+    || typeof state.loadingOlder !== "boolean" || typeof state.modelLabel !== "string" || !Array.isArray(state.messages)
+    || !["system", "custom"].includes(String(state.modelMode)) || !Array.isArray(state.modelGroups)
+    || !state.modelGroups.every(group => group && typeof group.id === "string" && typeof group.name === "string" && Array.isArray(group.models)
+      && group.models.every((model: Record<string, unknown>) => model && typeof model.id === "string" && typeof model.name === "string"
+        && (model.reasoning === undefined || validReasoning(model.reasoning))))
+    || (state.modelSelection !== null && !validSelection(state.modelSelection))
+    || (state.error !== undefined && typeof state.error !== "string")) return false;
+  return state.messages.every(message => message && typeof message.id === "string" && ["user", "assistant"].includes(message.role)
+    && typeof message.content === "string" && (message.error === undefined || typeof message.error === "string")
+    && (message.parts === undefined || (Array.isArray(message.parts) && message.parts.every((part: Record<string, unknown>) => part && typeof part.id === "string"
+      && (["text", "thinking"].includes(String(part.type)) ? typeof part.content === "string" : part.type === "tool" && validTool(part.tool))))));
+}
+
+function validSelection(value: unknown): boolean {
+  if (!value || typeof value !== "object") return false;
+  const selection = value as Record<string, unknown>;
+  return typeof selection.provider === "string" && typeof selection.model === "string" && (selection.reasoningEffort === undefined || typeof selection.reasoningEffort === "string");
+}
+
+function validReasoning(value: unknown): boolean {
+  if (!value || typeof value !== "object") return false;
+  const reasoning = value as Record<string, unknown>;
+  return (reasoning.defaultEffort === undefined || typeof reasoning.defaultEffort === "string") && Array.isArray(reasoning.efforts)
+    && reasoning.efforts.every(effort => effort && typeof effort.id === "string" && typeof effort.name === "string");
+}
+
+function validTool(value: unknown): boolean {
+  if (!value || typeof value !== "object") return false;
+  const tool = value as Record<string, unknown>;
+  return typeof tool.id === "string" && typeof tool.name === "string" && ["running", "success", "error", "interrupted"].includes(String(tool.status))
+    && (tool.result === undefined || typeof tool.result === "string") && (tool.args === undefined || (!!tool.args && typeof tool.args === "object" && !Array.isArray(tool.args)));
+}
+
+/** 接受后才清除首页需求；连接失败时可在当前项目重试。 */
+export function sendPendingStudioPrompt(): Promise<void> {
+  if (pendingSend) return pendingSend;
+  const workspace = useWorkspaceStore();
+  const message = workspace.pendingAgentMessage;
+  if (!message || message.directory !== currentContext.directory) return Promise.resolve();
+  const sending = sendStudioPrompt(message.directory, message.prompt, message.attachments ?? []).then(() => {
+    if (workspace.pendingAgentMessage === message) workspace.pendingAgentMessage = null;
+  });
+  pendingSend = sending.finally(() => { pendingSend = undefined; });
+  return pendingSend;
+}
+
+/** 附件先保存在项目内，以原路径交给 dsh；文本附件同时带入消息。 */
+export async function sendStudioPrompt(directory: string, prompt: string, attachments: AgentAttachment[], mentions: AgentMention[] = []) {
+  const files = useWorkspaceFiles(directory);
+  if (attachments.some(item => item.file)) for (const path of ["assets", "assets/chat"]) await files.mkdir(path).catch(error => {
+    if (error?.response?.data?.data?.code !== "EEXIST") throw error;
+  });
+  const parts = [mentionPlainText(prompt, mentions)];
+  if (mentions.length) parts.push("画布与素材引用：\n" + JSON.stringify(mentions));
+  for (const attachment of attachments) {
+    if (attachment.file) {
+      const extension = attachment.name.match(/\.[a-zA-Z0-9]{1,10}$/)?.[0].toLowerCase() ?? "";
+      const path = "assets/chat/" + crypto.randomUUID() + extension;
+      await files.write(path, attachment.file, true);
+      attachment.path = path;
+      attachment.file = undefined;
+    }
+    parts.push("附件：" + attachment.name + "\n相对路径：" + attachment.path);
+    if (attachment.mimeType === "text/plain") parts.push(await readTextAttachment(attachment, directory));
+  }
+  const text = parts.join("\n\n");
+  if (text.length > 100000) throw new Error("内容超过 100000 字符，请在 dsh 对话中引用附件路径");
+  await requestStudioSession("send", { directory, canvasId: currentContext.directory === directory ? currentContext.canvasId : null }, text);
+}
